# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# FLUXNET raw archives and unzipped source files — never commit
data/DE-Tha/raw/
data/DK-Sor/raw/
data/US-MMS/raw/

# Processed FLUXNET CSVs — large files, regenerated by download scripts
data/DE-Tha/*.csv
data/DK-Sor/*.csv
data/US-MMS/*.csv
data/US-NR1/*.csv

# US-NR1 raw archives and unzipped source files — never commit
data/US-NR1/raw/

# Student data zip and unpacked directory — distributed via Google Drive, not git
exercises/student_data/

# SSEM model output — generated by running exercises/01_run_model.Rmd
# (files exceed GitHub's 100 MB limit; regenerated by running the exercises)
# Also covers full-record outputs generated by exercises/run_full_record.R:
#   data/ssem_usnr1_fullrecord.rds
#   data/ssem_usmms_fullrecord.rds
data/*.rds
exercises/review_figures/*.rds
# Handoff workspaces — large generated files, regenerated by running 03_handoff.Rmd
exercises/output/*.RDS

# knitr intermediate figure directories (plots are embedded in HTML)
exercises/*_files/

# FLUXCOM raw downloads — large NetCDF files, obtained from https://doi.org/10.18160/5NZG-JMJE
# Extracted site CSVs (data/fluxcom/*.csv) are small and git-tracked, like data/cmip6/*.csv
data/fluxcom/raw/

# Plotly.js local cache — downloaded once by build_dashboard.R, not committed (3.6 MB)
exercises/.plotly.min.js
